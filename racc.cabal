cabal-version: 3.12
name: racc
version: 0.0.0
build-type: Simple

common shared
  default-language: GHC2024
  -- All warnings that concern code quality, as errors; .hie files for weeder.
  ghc-options:
    -Weverything
    -Werror
    -Wno-implicit-prelude
    -Wno-missing-safe-haskell-mode
    -Wno-safe
    -Wno-unsafe
    -Wno-missed-specialisations
    -Wno-all-missed-specialisations
    -Wno-missing-kind-signatures
    -fwrite-ide-info

  build-depends: base

library
  import: shared
  hs-source-dirs: src
  build-depends:
    bytestring,
    containers,
    transformers,

  exposed-modules:
    Racc
    Racc.Diagnostic
    Racc.Lexer
    Racc.Parser
    Racc.Resolve
    Racc.Syntax

executable racc
  import: shared
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
    bytestring,
    racc,

test-suite tests
  import: shared
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    LexerTests
    ParserTests

  build-depends:
    bytestring,
    filepath,
    process,
    racc,
    tasty,
    tasty-golden,
    tasty-hunit,
    tasty-quickcheck,
    temporary,
