-- A block gives its value with `return`; a one-line body is its value.
sign x =
  if x < 0
    return -1
  elif x == 0
    return 0
  return 1
clamp x = if x < 0 then 0 else x

-- A body whose result is `Void` may end without `return`, and one that
-- never ends needs none.
show x =
  if x > 0
    print x
    return
  print 0
search n =
  state
    i = 0
  while True
    if i * i >= n
      return i
    i = i + 1

-- After `->`, a simple statement may follow on the same line.
loops n =
  state
    total : Int
    total = 0
    a = 0
    b = 1
  for i in 0 until n by 2
    (a, b) = (b, a + b)
    if i == 3
      break
    else
      continue
  for j in n downto 0
    match j
      0 -> break
      _ -> total = total - j
  while total > 0
    total = total - 1
    pass

-- The block of a value or binding is a body of its own.
blocks c =
  v =
    if c
      return 1
    return 2
  (p, q) =
    return (v, v)
  return p + q

-- A state variable's signature may use those of its function.
keep : a -> a
keep x =
  state
    s : a
    s = x
  return s

-- A statement's value is discarded with a warning.
discards x =
  x + 1
  if x > 0
    x
  match x
    0 -> True
    _ -> pass
  print x
