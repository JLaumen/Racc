(eq localFunctions () (block (sig g (-> Int Int)) (eq g (y) y) (app g 1)))
(eq guards () (block (eq g (y) (guards ((cmp y > 0) 1) (otherwise 2))) g))
(eq stateVariables () (block (eq g () (block (state (var s 1)) s)) g))
(eq bindings () (block (bind (tuple a _) p) (bind (Just (P b)) q) (bind (as (or A B) c) r) (bind (as x y) t) (bind (or x y) u) (bind (tuple -1 ()) s) a))
(eq ifs () (block (if ((if a b c) (block d))) (if (e (block f)) (g (block h)) (else (block i)))))
(eq expressions () (block (if a b c) (app Foo 1)))
(eq loops () (block (while a (block b)) (for (tuple i j) (to 1 n 2) (block pass)) (for i (until a b) (block pass)) (for i (downto a b) (block pass))))
(eq matches () (block (match x ((Just y) (block y)) (N (guards (a (block 1)) (otherwise (block 2)))) (_ (block pass)))))
(eq jumps () (block (return) (return a) (break) (break 2) (continue) (continue 2)))
